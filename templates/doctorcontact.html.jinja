<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/static/images/logotab.png" type="image/x-icon">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Contact Dr. {{ doctor['Name'] }}</title>
</head>
<body class="bg-gray-50 min-h-screen font-sans dark:bg-gray-900 dark:text-white">

{% include "components/navbartwo.html.jinja" %}

<div class="max-w-7xl mx-auto p-6 mt-10 dark:bg-gray-900 dark:text-white">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 dark:bg-gray-900 dark:text-white">

        <!-- Doctor Info Sidebar -->
        <div class="lg:col-span-4 bg-white p-6 rounded-lg shadow-lg space-y-4 dark:bg-gray-900 dark:text-white">
            <img src="{{ doctor['Image'] }}" alt="{{ doctor['Name'] }}" class="w-full rounded-lg object-cover  dark:text-white">
            <h1 class="text-2xl font-bold text-purple-800  dark:text-white">Dr. {{ doctor['Name'] }}</h1>
            <p class="text-gray-700  dark:text-white">{{ doctor['Category'] }} • {{ doctor['Type'] }}</p>
            <p class="text-gray-600  dark:text-white">📍 {{ doctor['Location'] }}</p>
            <p class="text-gray-700 mt-2  dark:text-white ">{{ doctor['Description'] }}</p>
            <p class="text-gray-600 font-semibold mt-4  dark:text-white">Accepted Insurance:</p>
            <p class="text-gray-700  dark:text-white">{{ doctor['Insurance'] }}</p>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-8 bg-white p-8 rounded-lg shadow-lg dark:bg-gray-900 ">
            <h2 class="text-2xl font-bold text-purple-800 mb-4 dark:bg-gray-900 dark:text-white ">Have Questions? Send  us a Message</h2>

            {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                {% for category, message in messages %}
                <div class="mb-4 p-4 rounded shadow
                    {% if category == 'success' %}bg-green-100 text-green-800{% elif category == 'error' %}bg-red-100 text-red-800{% else %}bg-gray-100 text-gray-800{% endif %}">
                    {{ message }}
                </div>
                {% endfor %}
            {% endif %}
            {% endwith %}

            <form method="post" class="space-y-4 dark:bg-gray-900 dark:text-white">
                <div>
                    <label class="block text-gray-700 font-semibold mb-1 dark:bg-gray-900 dark:text-white">Your Name</label>
                    <input type="text" name="name" required
                           class=" dark:bg-gray-900 dark:text-white w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                </div>

                <div>
                    <label class="block text-gray-700 font-semibold mb-1 dark:bg-gray-900 dark:text-white">Email</label>
                    <input type="email" name="email" required
                           class=" dark:bg-gray-900 dark:text-white w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                </div>

                <div>
                    <label class="block text-gray-700 font-semibold mb-1 dark:bg-gray-900 dark:text-white">Message</label>
                    <textarea name="message" rows="6" required
                              class="dark:bg-gray-900 dark:text-white w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500"></textarea>
                </div>

                <button type="submit"
                        class="px-6 py-2 bg-purple-700 text-white rounded-full font-semibold hover:bg-purple-800 transition">
                    Send Message
                </button>
            </form>
        </div>

    </div>
</div>


<script>
  const toggle = document.getElementById("theme-toggle");

  // Load saved theme
  if (localStorage.getItem("theme") === "dark") {
    document.documentElement.classList.add("dark");
  }

  // Set icon on load
  toggle.textContent = document.documentElement.classList.contains("dark") ? "☀️" : "🌙";

  toggle.addEventListener("click", () => {
    document.documentElement.classList.toggle("dark");

    if (document.documentElement.classList.contains("dark")) {
      localStorage.setItem("theme", "dark");
      toggle.textContent = "☀️";
    } else {
      localStorage.setItem("theme", "light");
      toggle.textContent = "🌙";
    }
  });
</script>
</body>
</html>