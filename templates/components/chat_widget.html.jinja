<!-- FLOATING CHAT BUTTON -->
<button
  id="chat-toggle"
  onclick="toggleChat()"
  class="fixed bottom-6 right-6 z-50 bg-purple-600 hover:bg-purple-700 text-white w-16 h-16 rounded-full shadow-2xl text-2xl">
  💬
</button>

<!-- CHAT WINDOW -->
<div
  id="chat-widget"
  class="hidden fixed bottom-24 right-6 w-96 max-w-[90vw] bg-white dark:bg-gray-900 border rounded-2xl shadow-2xl z-50 overflow-hidden">

  <!-- HEADER -->
  <div class="bg-purple-600 text-white px-4 py-3 flex justify-between">
    <h2 class="font-semibold">BookWell Assistant</h2>
    <button onclick="toggleChat()">✕</button>
  </div>

  <!-- CHAT BOX -->
  <div id="chat-box" class="p-4 h-96 overflow-y-auto space-y-2">
    <div class="text-sm text-gray-500">
      🤖 Hi! What symptoms are you experiencing?
    </div>
  </div>

  <!-- INPUT -->
  <div class="flex gap-2 p-3 border-t">
    <input id="chat-input"
      class="flex-1 border rounded px-3 py-2"
      placeholder="Type symptoms...">

 <button onclick="sendMessage()"
  class="bg-blue-600 text-white px-4 py-2 rounded">
  Send
</button>

<div id="book-btn-container" class="hidden fixed bottom-24 right-6 z-50">
  <button
    id="find-appointment-btn"
    class="bg-green-600 hover:bg-green-700 text-white px-4 py-3 rounded-xl shadow-xl">
    Find Appointment
  </button>
  <!-- GLOBAL APPOINTMENT BUTTON -->
<a href="/doctorsearch"
   class="fixed bottom-24 left-6 z-50 bg-blue-600 hover:bg-blue-700 text-white px-5 py-3 rounded-full shadow-xl">
   Find Appointment
</a>
</div>
<!-- GLOBAL APPOINTMENT BUTTON -->

<button onclick="resetChat()"
  class="bg-gray-300 px-4 py-2 rounded">
  New
</button>
  </div>

</div>

<script>
let selectedCategory = null;

document.addEventListener("click", function(e) {
  if (e.target && e.target.id === "find-appointment-btn") {
    if (!selectedCategory) return;

    // send user to doctor search page with category
    window.location.href = `/doctorsearch?category=${encodeURIComponent(selectedCategory)}`;
  }
});

function handleBotResponse(data) {
  const btn = document.getElementById("book-btn-container");

  if (data.show_booking) {
    selectedCategory = data.category;
    btn.classList.remove("hidden");
  } else {
    btn.classList.add("hidden");
  }
}
</script>