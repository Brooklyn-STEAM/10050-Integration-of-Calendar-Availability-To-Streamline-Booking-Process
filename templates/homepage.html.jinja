<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="shortcut icon" href="/static/images/logotab.png" type="image/x-icon">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen w-screen overflow-x-hidden flex flex-col">

  {% include "components/navbar.html.jinja"%}

  <section class="relative min-h-[50vh] md:h-screen/2 flex items-center justify-center
px-0 md:px-6
bg-[url('/static/images/medicinebg.jpeg')] bg-cover bg-center bg-no-repeat">

    <div class="absolute inset-0 bg-purple-600/30"></div>

    <div class="relative w-full md:max-w-4xl text-center px-4 md:px-0">
      <h1 class="text-3xl md:text-5xl font-bold text-white drop-shadow">
        Book Smarter. Faster. Better.
      </h1>

      <p class="mt-6 text-base md:text-xl text-white/90">
        Book, manage, and reschedule NYU Langone appointments with ease --
        synced to your calendar and tailored to your availability.
      </p>


      {%if not current_user.is_authenticated%}
      <div class="mt-8 flex flex-col md:flex-row justify-center gap-4">
        <a href="/signup"
          class="w-full md:w-auto px-6 py-3 bg-white text-purple-600 font-semibold rounded-lg text-center hover:bg-purple-100 transition">
          Get Started
        </a>

        <a href="/doctorlogin"
          class="w-full md:w-auto px-6 py-3 bg-white text-purple-600 font-semibold rounded-lg text-center hover:bg-purple-100 transition">
          Doctor's Get Started
        </a>
        {%endif%}
        <br>

        <a href="https://mychart.nyulmc.org/mychart/Authentication/Login" target="_blank"
          class="w-full md:w-auto px-6 py-3 bg-white text-purple-600 font-semibold rounded-lg text-center hover:bg-purple-100 transition">
          Connect MyChart
        </a>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 px-6 py-16">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

      <div class="border-l-0 md:border-l-4 border-purple-600 md:pl-6 flex justify-center">
        <img src="/static/images/nyulangone.jpeg" alt="NYU Langone"
          class="w-3/4 md:h-48 md:w-auto shadow-lg rounded-lg">
      </div>

      <div class="text-center md:text-left">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
          Everything You Need in One Place
        </h2>

        <p class="mt-4 text-gray-600 leading-relaxed text-sm md:text-base">
          Manage appointments, automate reminders, reduce no-shows, and deliver
          a seamless scheduling experience for your clients.
        </p>

        <ul class="mt-6 space-y-3 text-gray-700 text-sm md:text-base">
          <li>✔ Smart calendar management</li>
          <li>✔ Automated email & SMS reminders</li>
          <li>✔ Secure your appointment</li>
          <li>✔ Real-time availability</li>
        </ul>

      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16 px-6">
    <div class="max-w-6xl mx-auto text-center">

      <h2 class="text-3xl font-bold text-gray-900">
        What Patients Say
      </h2>

      <div class="mt-12 grid md:grid-cols-3 gap-8">

        <div class="bg-white p-6 rounded-xl shadow hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
          <p class="text-gray-600">
            "Booking my NYU appointment took less than 30 seconds."
          </p>
          <h4 class="mt-4 font-semibold">Sarah L.</h4>
        </div>

        <div class="bg-white p-6 rounded-xl shadow hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
          <p class="text-gray-600">
            "Easy to use website !."
          </p>
          <h4 class="mt-4 font-semibold">James T.</h4>
        </div>

        <div class="bg-white p-6 rounded-xl shadow hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
          <p class="text-gray-600">
            "The reminders saved me from missing my appointment."
          </p>
          <h4 class="mt-4 font-semibold">Michael R.</h4>
        </div>

      </div>
    </div>
  </section>

  <footer class="bg-purple-100 text-gray-700 py-10">

    <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-8 text-center md:text-left px-6">

      <div>
        <h3 class="text-purple-700 font-semibold text-lg">BookWell</h3>
        <p class="mt-2 text-sm">
          Smarter appointment scheduling for NYU Langone patients.
        </p>
      </div>

      <div>
        <h3 class="text-purple-700 font-semibold text-lg">Links</h3>
        <ul class="mt-2 space-y-2 text-sm">
          <li>
            <a href="/signup" class="hover:text-purple-700 hover:underline transition">
              Sign Up
            </a>
          </li>

          <li>
            <a href="/doctorlogin" class="hover:text-purple-700 hover:underline transition">
              Doctor Login
            </a>
          </li>

          <li>
            <a href="/contact" class="hover:text-purple-700 hover:underline transition">
              Support
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-purple-700 font-semibold text-lg">Contact</h3>
        <p class="text-sm mt-2">
          jquiles@brooklynsteamcenter<br>
          jprity@brooklynsteamcenter<br>
          swhite2@brooklynsteamcenter
        </p>
      </div>

    </div>

    <p class="text-center text-sm mt-8 text-gray-600">
      © 2026 BookWell. All rights reserved.
    </p>

  </footer>

</body>

</html>