<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Doctor Login</title>
  <link rel="shortcut icon" href="/static/images/logotab.png" type="image/x-icon">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-white min-h-screen flex flex-col">

  <div class="w-full min-h-screen flex ">

    <div class="w-full lg:w-1/2 flex items-center justify-center bg-white px-6 py-12 dark:bg-gray-900 dark:text-white">

      <div class="w-full max-w-md space-y-6 dark:bg-gray-900 dark:text-white">

        <h2 class="text-3xl font-bold text-gray-800 dark:bg-gray-900 dark:text-white">Doctor Login</h2>
        <p class="text-gray-500">Sign in to manage your appointments</p>

        {% with messages = get_flashed_messages() %}
        {% if messages %}
        <div class="space-y-2">
          {% for message in messages %}
          <p class="text-red-500 text-sm">{{ message }}</p>
          {% endfor %}
        </div>
        {% endif %}
        {% endwith %}

        <form action="/doctorlogin" method="post" class="space-y-4">

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1 dark:bg-gray-900 dark:text-white">
              Email
            </label>
            <input name="email" type="email" required placeholder="you@hospital.com"
              class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500 focus:outline-none dark:bg-gray-900 dark:text-white" />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1 dark:bg-gray-900 dark:text-white">
              Password
            </label>
            <input name="password" type="password" required placeholder="••••••••"
              class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500 focus:outline-none dark:bg-gray-900 dark:text-white" />
          </div>

          <div class="flex items-center justify-between text-sm">
            <label class="flex items-center gap-2 text-gray-600 dark:bg-gray-900 dark:text-white">
              <input type="checkbox" class="rounded border-gray-300 text-purple-600 focus:ring-purple-500 dark:bg-gray-900 dark:text-white">
              Remember me
            </label>
          </div>

          <button type="submit"
            class="w-full bg-purple-600 text-white py-2 rounded-lg hover:bg-purple-700 transition duration-300">
            Sign In
          </button>

        </form>

        <div class="flex items-center">
          <div class="flex-1 border-t"></div>
          <span class="px-3 text-sm text-gray-400">or</span>
          <div class="flex-1 border-t"></div>
        </div>

        <a href="https://mychart.nyulmc.org/mychart/Authentication/Login" target="_blank" rel="noopener noreferrer"
          class="block w-full text-center border border-purple-600 text-purple-600 py-2 rounded-lg hover:bg-purple-100 transition">
          Connect with MyChart
        </a>
        <p class="text-sm text-gray-500">
          Have a user's account?
          <a href="/login" class="text-purple-600 hover:underline">Login</a>
        </p>


      </div>
    </div>


   <style>
@keyframes slowPan {
  0% {
    transform: scale(1.1) translateX(0px) translateY(0px);
  }
  50% {
    transform: scale(1.15) translateX(-30px) translateY(-20px);
  }
  100% {
    transform: scale(1.1) translateX(0px) translateY(0px);
  }
}

.moving-bg {
  animation: slowPan 20s ease-in-out infinite;
}
</style>

<div class="hidden lg:block relative w-1/2 h-screen overflow-hidden">

  
  <img
    src="/static/images/doctorlog.jpeg"
    alt="Doctor Login Illustration"
    class="absolute w-[110%] h-[110%] object-cover moving-bg"
  />

 
  <div class="absolute inset-0 bg-black/40 flex items-center justify-center">

    <div class="text-center text-white space-y-4 px-6">
      <h2 class="text-4xl font-bold">Welcome Back!</h2>
      <p class="text-lg">Access your schedule, appointments, and patient information.</p>
    </div>

  </div>

</div>
  </div>

</body>

</html>