<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Message Received | BookWell</title>
  <link rel="shortcut icon" href="/static/images/logotab.png" type="image/x-icon">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-white">

  {% include "components/navbar.html.jinja"%}

  <div class="min-h-screen flex items-center justify-center px-6 py-16">
    <div class="max-w-3xl w-full bg-white shadow-xl rounded-2xl p-10 dark:bg-gray-900 dark:text-white">

      
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-indigo-600 dark:text-white">BookWell</h1>
      </div>

      
      <div class="flex justify-center mb-6">
        <div class="bg-green-100 p-4 rounded-full">
          <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" stroke-width="2"
            viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </div>

    
      <div class="text-center mb-6">
        <h2 class="text-2xl md:text-3xl font-bold mb-3 dark:text-white">
          Thanks for Contacting Us! 💬
        </h2>
        <p class="text-gray-600 text-lg dark:text-white">
          We've received your message and our team will get back to you as soon as possible.
        </p>
      </div>

      
      <div class="bg-indigo-50 rounded-xl p-6 mb-8">
        <h3 class="font-semibold text-lg mb-4 text-indigo-700">
          Here’s What Happens Next:
        </h3>

        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <div class="bg-indigo-600 text-white w-8 h-8 flex items-center justify-center rounded-full font-semibold">1</div>
            <p class="text-gray-700">Our support team will review your message.</p>
          </div>

          <div class="flex items-start gap-4">
            <div class="bg-indigo-600 text-white w-8 h-8 flex items-center justify-center rounded-full font-semibold">2</div>
            <p class="text-gray-700">We’ll respond to you via email within 24–48 hours.</p>
          </div>

          <div class="flex items-start gap-4">
            <div class="bg-indigo-600 text-white w-8 h-8 flex items-center justify-center rounded-full font-semibold">3</div>
            <p class="text-gray-700">If your matter is urgent, feel free to reach out again.</p>
          </div>
        </div>
      </div>

      <div class="text-center mb-8">
        <h3 class="text-xl font-semibold mb-2 dark:text-white">
          Need immediate assistance?
        </h3>
        <p class="text-gray-600  dark:text-white">
          You can explore our FAQ section or reach out directly to our support team.
        </p>
      </div>

    
      <div class="text-center">
        <a href="/"
          class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-lg transition duration-200">
          Back to Home
        </a>

        <p class="text-sm text-gray-500 mt-4 dark:text-white">
          We appreciate you reaching out to BookWell 💙
        </p>
      </div>

    </div>
  </div>

</body>
</html>