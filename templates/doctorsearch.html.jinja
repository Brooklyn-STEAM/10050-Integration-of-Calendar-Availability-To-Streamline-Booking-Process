<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
{% include "components/navbar.html.jinja"%}
<div class="max-w-6xl mx-auto px-4 py-8">

  
  <div class="bg-white shadow-md rounded-lg p-4 mb-8 flex flex-col md:flex-row gap-4 items-center justify-between">
    
    
    <div class="flex w-full md:w-2/3">
      <input 
        type="text" 
        placeholder="Search doctors..."
        class="w-full px-4 py-2 border border-gray-300 rounded-l-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
      <button class="bg-purple-700 text-white px-6 rounded-r-lg hover:bg-gray-700">
        Search
      </button>
    </div>

   
    <select class="w-full md:w-1/3 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 ">
      <option value="">Filter</option>
      <option>Cardiology</option>
      <option>Neurology</option>
      <option>Orthopedics</option>
    </select>

  </div>


  <div class="bg-white shadow-md rounded-lg p-6 mb-6 flex flex-col md:flex-row gap-6 items-start">

   
    <img 
      src="/static/images/doctors/michael-alaia-md-prfle.webp"
      alt="Doctor"
      class="w-32 h-32 object-cover rounded-full border-4 border-[#BF5700]"
    />

  
    <div class="flex-1">

    
      <div class="flex text-yellow-400 mb-2 text-lg">
        ★ ★ ★ ★ ☆
        <span class="ml-2 text-gray-600 text-sm">(4.0)</span>
      </div>

    
      <h2 class="text-xl font-semibold text-gray-800">
        Michael J. Alaia
      </h2>

     
      <p class="text-gray-600 mt-2">
        Orthopedic Surgeon

      </p>

    </div>
  </div>


  
  <div class="bg-white shadow-md rounded-lg p-6 mb-6 flex flex-col md:flex-row gap-6 items-start">

    <img 
      src="/static/images/doctors/julie-c-delphin-square.jpg"
      alt="Doctor"
      class="w-32 h-32 object-cover rounded-full border-4 border-[#BF5700]"
    />

    <div class="flex-1">

      <div class="flex text-yellow-400 mb-2 text-lg">
        ★ ★ ★ ★ ★
        <span class="ml-2 text-gray-600 text-sm">(5.0)</span>
      </div>

      <h2 class="text-xl font-semibold text-gray-800">
        Julie C. Delphine
      </h2>

      <p class="text-gray-600 mt-2">
        Cardiologist for women’s health
      </p>

    </div>
  </div>

</div>

</body>