<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="shortcut icon" href="/static/images/logotab.png" type="image/x-icon">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <style>
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.page-fade {
  animation: fadeUp 0.8s ease forwards;
}


.card {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeUp 0.6s ease forwards;
}

.card:nth-child(1) { animation-delay: 0.06s; }
.card:nth-child(2) { animation-delay: 0.2s; }
.card:nth-child(3) { animation-delay: 0.15s; }
.card:nth-child(4) { animation-delay: 0.2s; }
.card:nth-child(5) { animation-delay: 0.25s; }
</style>
</head>

<body class="dark:bg-gray-900 dark:text-white">
  {% include "components/navbar.html.jinja"%}


  

{% if result %}
  <div class="mb-6 p-4 rounded-xl border transition-all duration-300
    {% if result.urgency == 'critical' %}
      bg-red-100 border-red-300 text-red-900
      dark:bg-red-950/40 dark:border-red-700 dark:text-red-200
    {% elif result.urgency == 'high' %}
      bg-red-50 border-red-200 text-red-900
      dark:bg-red-950/30 dark:border-red-800 dark:text-red-200
    {% elif result.urgency == 'medium' %}
      bg-yellow-50 border-yellow-200 text-yellow-900
      dark:bg-yellow-950/30 dark:border-yellow-800 dark:text-yellow-200
    {% else %}
      bg-green-50 border-green-200 text-green-900
      dark:bg-green-950/30 dark:border-green-800 dark:text-green-200
    {% endif %}">

   {% if result and result.specialists %}
  Recommended Specialist: {{ result.specialists[0].name }}
{% endif %}

    <div class="mt-2 text-sm space-y-1">
      {% for spec in result.specialists %}
        <p>
          {{ spec.name }} — {{ (spec.confidence * 100)|round(0) }}%
        </p>
      {% endfor %}
    </div>

    <p class="text-sm mt-3 opacity-90">
      {{ result.message }}
    </p>

    <p class="text-xs mt-2 opacity-70">
      This is not medical advice. If symptoms are severe, seek emergency care.
    </p>

    {% if result.urgency in ['high', 'critical'] %}
      <div class="mt-4 flex gap-3">

        <form method="POST" action="/auto-book">
          <input type="hidden" name="category" value="{{ result.specialists[0].name }}">
          <button type="submit"
            onclick="this.innerHTML='⏳ Finding...'; setTimeout(() => this.disabled=true, 100);"
            class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition disabled:opacity-50">
            Yes, find earliest appointment
          </button>
        </form>

        <button onclick="this.parentElement.style.display='none'"
          class="bg-gray-200 dark:bg-gray-700 px-4 py-2 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600">
          No
        </button>

      </div>
    {% endif %}

  </div>
{% endif %}




