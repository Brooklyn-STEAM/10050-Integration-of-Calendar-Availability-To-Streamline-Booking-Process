<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
  {% include "components/navbar.html.jinja"%}


  <div class="max-w-6xl mx-auto px-4 py-8">


    <form method="get" action="/doctorsearch" class="flex flex-col md:flex-row gap-4 mb-6">
      <input type="text" name="q" value="{{ search_query|default('') }}" placeholder="Search doctors..."
        class="w-full px-4 py-2 border border-gray-300 rounded-l-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
      <select name="category"
        class="w-full md:w-1/3 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2">
        <option value="">All Categories</option>
        <option value="Cardiology" {% if category_filter=='Cardiology' %}selected{% endif %}>Cardiology</option>
        <option value="Neurology" {% if category_filter=='Neurology' %}selected{% endif %}>Neurology</option>
        <option value="Orthopedics" {% if category_filter=='Orthopedics' %}selected{% endif %}>Orthopedics</option>
      </select>
      <button type="submit" class="bg-purple-700 text-white px-6 rounded-lg hover:bg-gray-700">
        Search
      </button>
    </form>


    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10 sm: grid-cols-2 gap-10">
      {% for doctor in doctors %}
      <a href="/doctor/{{ doctor['ID'] }}" class="group">
        <div class="bg-white shadow-md rounded-lg p-6 flex flex-col items-center">
          <img src="{{ doctor['Image'] }}" alt="{{ doctor['Name'] }}"
            class="w-32 h-32 object-cover rounded-full border-4 border-[#BF5700]" />

          <div class="flex-1 mt-4 space-y-2">
            <h2 class="text-xl font-semibold text-gray-800">
              {{ doctor['Name'] }}
            </h2>



            <p class="text-sm text-gray-500 mt-2">
              {{ doctor['Category'] }}
            </p>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>

  </div>

</body>

</html>