    <div class="max-w-xl mx-auto mt-6">

  <!-- Chat box -->
  

    <div id="chat-box" class="bg-white border rounded-xl p-4 h-96 overflow-y-auto space-y-3">
  <div class="text-sm text-gray-500">
    🤖 Hi! What symptoms are you experiencing?
  </div>
</div>

<div class="flex mt-3 gap-2">
  <input id="chat-input" type="text"
    placeholder="Type your symptoms..."
    class="flex-1 border rounded-lg px-3 py-2">

  <button onclick="sendMessage()"
    class="bg-blue-600 text-white px-4 py-2 rounded-lg">
    Send
  </button>

  <button onclick="resetChat()" 
    class="px-3 py-2 bg-gray-300 rounded">
    New Chat
  </button>
</div>


   

</div>

  </div>

 <script id="symptom-js">
const symptomMap = {{ SYMPTOM_MAP | tojson }};

const input = document.getElementById("symptoms");
const suggestionBox = document.getElementById("suggestion");

input.addEventListener("input", function () {
    const value = input.value.toLowerCase();
    let matchedCategories = new Set();

    for (const keyword in symptomMap) {
        if (value.includes(keyword)) {
            symptomMap[keyword].forEach(cat => matchedCategories.add(cat));
        }
    }

    if (matchedCategories.size > 0) {
        suggestionBox.innerText = "Recommended: " + [...matchedCategories].join(", ");
    } else {
        suggestionBox.innerText = "";
    }
});
</script>



</body>

</html>

<script>
let typingIndicator = null;

// ---------------- ADD MESSAGE ----------------
function addMessage(text, sender="user") {
  const box = document.getElementById("chat-box");

  const msg = document.createElement("div");
  msg.className = sender === "user" ? "text-right mb-2" : "text-left mb-2";

  msg.innerHTML = `
    <div class="inline-block px-4 py-2 rounded-xl max-w-[80%] ${
      sender === "user"
        ? "bg-blue-600 text-white"
        : "bg-gray-200 text-black"
    }">
      ${text}
    </div>
  `;

  box.appendChild(msg);
  box.scrollTop = box.scrollHeight;
}

// ---------------- SHOW TYPING ----------------
function showTyping() {
  hideTyping();

  const box = document.getElementById("chat-box");

  typingIndicator = document.createElement("div");
  typingIndicator.id = "typing";

  typingIndicator.innerHTML = `
    <div class="inline-block px-4 py-2 rounded-xl bg-gray-200 text-black">
      Typing...
    </div>
  `;

  box.appendChild(typingIndicator);
  box.scrollTop = box.scrollHeight;
}

// ---------------- HIDE TYPING ----------------
function hideTyping() {
  const existing = document.getElementById("typing");

  if (existing) {
    existing.remove();
  }

  typingIndicator = null;
}

// ---------------- RESET CHAT ----------------
function resetChat() {
  fetch("/reset-chat")
    .then(() => {
      document.getElementById("chat-box").innerHTML = `
        <div class="text-sm text-gray-500">
          🤖 Hi! What symptoms are you experiencing?
        </div>
      `;
    });
}

// ---------------- FORMAT ----------------
function formatText(text) {
  return text
    .replace(/\n/g, "<br>")
    .replace(/\*\*(.*?)\*\*/g, "<b>$1</b>");
}

// ---------------- SEND MESSAGE ----------------
function sendMessage() {
  const input = document.getElementById("chat-input");

  if (!input) return;

  const text = input.value.trim();

  if (text === "") return;

  // show user message
  addMessage(text, "user");

  // clear input
  input.value = "";

  // show typing
  showTyping();

  fetch("/chat-symptoms", {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      message: text
    })
  })
  .then(response => response.json())
  .then(data => {

    hideTyping();

    if (data.reply) {
      addMessage(formatText(data.reply), "bot");
    } else {
      addMessage("Something went wrong.", "bot");
    }

    if (data.show_booking) {
      addMessage(`
        <button class="mt-2 bg-red-600 text-white px-4 py-2 rounded">
          Find Appointment
        </button>
      `, "bot");
    }
  })
  .catch(error => {

    console.log(error);

    hideTyping();

    addMessage(
      "Server connection issue. Please try again.",
      "bot"
    );
  });
}

// ---------------- ENTER KEY ----------------
document.addEventListener("DOMContentLoaded", function () {

  const input = document.getElementById("chat-input");

  input.addEventListener("keypress", function(e) {

    if (e.key === "Enter") {
      e.preventDefault();
      sendMessage();
    }

  });

});
</script>