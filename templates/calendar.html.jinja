<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Calendar</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}


.calendar-wrap {
  animation: fadeUp 0.6s ease forwards;
}


.day-cell {
  opacity: 0;
  animation: fadeUp 0.4s ease forwards;
}


.day-cell:hover {
  transform: translateY(-2px);
  transition: all 0.2s ease;
}
</style>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">

    {% include "components/navbar.html.jinja" %}

    <section class="px-4 py-10 flex-grow">

        <!-- TITLE -->
        <h1 class="text-3xl font-bold text-center mb-10 text-gray-800">
            {{ month_name }} {{ year }}
        </h1>

        <!-- CALENDAR -->
        <div class="max-w-5xl mx-auto">

            <!-- Days of week -->
            <div class="hidden lg:grid grid-cols-7 gap-2 text-center text-sm font-semibold text-gray-600 mb-2">
                <div>Sun</div>
                <div>Mon</div>
                <div>Tue</div>
                <div>Wed</div>
                <div>Thu</div>
                <div>Fri</div>
                <div>Sat</div>
            </div>

            <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-2 max-w-4xl calendar-wrap">

                {% for week in calendar %}
                {% for day in week %}
                {% if day == 0 %}
                    <div></div>
                {% else %}

                {% set full_date = year ~ "-" ~ "%02d"|format(month) ~ "-" ~ "%02d"|format(day) %}

                <div class="bg-white border border-gray-200 rounded-lg p-2 min-h-[110px] shadow-sm hover:shadow-md transition relative">

                    <!-- Day -->
                    <div class="text-sm font-bold
                        {% if full_date == today %}
                            text-purple-700
                        {% else %}
                            text-gray-700
                        {% endif %}
                    ">
                        {{ day }}
                    </div>

                    <!-- Events -->
                    {% if full_date in events %}
                        <div class="mt-1 space-y-1 max-h-20 overflow-y-auto">
                            {% for appt in events[full_date] %}
                                <div class="text-xs px-2 py-1 rounded
                                    {% if appt.Status == 'Cancelled' %}
                                        bg-red-100 text-red-700
                                    {% elif appt.Status == 'Personal' %}
                                        bg-purple-100 text-purple-700
                                    {% else %}
                                        bg-blue-100 text-blue-700
                                    {% endif %}
                                ">
                                    {{ appt.Type }}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                </div>

                {% endif %}
                {% endfor %}
                {% endfor %}

            </div>
        </div>

        <!-- FORMS SECTION -->
        <div class="max-w-5xl mx-auto mt-12 space-y-10">

            <!-- ADD EVENT -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h2 class="text-xl font-bold mb-4">+ Add Personal Event</h2>

                <form method="POST" action="/add-event" class="space-y-4">

                    <input type="text" name="title" placeholder="Event name"
                        class="w-full border px-4 py-2 rounded-lg" required>

                    <input type="date" name="date"
                        class="w-full border px-4 py-2 rounded-lg" required>

                    <input type="time" name="time"
                        class="w-full border px-4 py-2 rounded-lg" required>

                    <button type="submit"
                        class="w-full bg-purple-700 text-white py-2 rounded-lg hover:bg-purple-800">
                        Add Event
                    </button>

                </form>
            </div>

            <!-- FIND DOCTORS -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h2 class="text-xl font-bold mb-4">Find Available Doctors</h2>

                <form method="POST" action="/suggdoctors" class="space-y-4">

                    <input type="date" name="date" required
                        class="w-full border px-4 py-2 rounded-lg">

                    <select name="category"
                        class="w-full border px-4 py-2 rounded-lg">
                        <option value="">All Categories</option>
                        <option value="Cardiology">Cardiology</option>
                        <option value="Neurology">Neurology</option>
                        <option value="Orthopedics">Orthopedics</option>
                    </select>

                    <button type="submit"
                        class="w-full bg-green-600 text-white py-2 rounded-lg hover:bg-green-700">
                        Suggest Doctors
                    </button>

                </form>
            </div>

        </div>

    </section>

    <footer class="bg-[#57068c] text-white text-center py-4 mt-auto">
        © 2026 — Book fast. Smart care, no cast
    </footer>

</body>
</html>