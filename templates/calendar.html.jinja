<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Calendar</title>
    <link rel="shortcut icon" href="/static/images/logotab.png" type="image/x-icon">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        .calendar-wrap {
            animation: fadeUp 0.6s ease forwards;
        }


        .day-cell {
            opacity: 0;
            animation: fadeUp 0.4s ease forwards;
        }


        .day-cell:hover {
            transform: translateY(-2px);
            transition: all 0.2s ease;
        }
    </style>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col dark:bg-gray-900 dark:text-white">
    {% include "components/navbar.html.jinja" %}

    {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
    <div class="max-w-5xl mx-auto mt-6 px-4 space-y-3">

        {% for category, message in messages %}
        <div class="
        flex items-center justify-between
        p-4 rounded-lg shadow-sm border
        transition-all duration-200

        {% if category == 'error' %}
            bg-red-50 border-red-200 text-red-700
        {% elif category == 'success' %}
            bg-green-50 border-green-200 text-green-700
        {% elif category == 'warning' %}
            bg-yellow-50 border-yellow-200 text-yellow-800
        {% else %}
            bg-blue-50 border-blue-200 text-blue-800
        {% endif %}
    ">

            <div class="flex items-center gap-3">
                {% if category == 'error' %}
                <span class="text-xl">❌</span>
                {% elif category == 'success' %}
                <span class="text-xl">✅</span>
                {% elif category == 'warning' %}
                <span class="text-xl">⚠️</span>
                {% else %}
                <span class="text-xl">ℹ️</span>
                {% endif %}

                <p class="font-medium">{{ message }}</p>
            </div>

        </div>
        {% endfor %}

    </div>
    {% endif %}
    {% endwith %}

    <section class="px-4 py-10 flex-grow">



        <div class="flex justify-between items-center mb-6">


            <a href="/calendar?month={{ month - 1 }}&year={{ year }}"
                class="px-4 py-2 bg-white rounded hover:bg-gray-300 text-black ">
                ← Prev
            </a>


            <h1 class="text-3xl font-bold text-gray-800 dark:text-white">
                {{ month_name }} {{ year }}
            </h1>


            <a href="/calendar?month={{ month + 1 }}&year={{ year }}"
                class="px-4 py-2 bg-white rounded hover:bg-gray-300 text-black ">
                Next →
            </a>

        </div>

        <div class="max-w-5xl mx-auto">


            <div
                class="hidden lg:grid grid-cols-7 gap-2 text-center text-sm font-semibold text-gray-600 dark:text-white mb-2">
                <div>Sun</div>
                <div>Mon</div>
                <div>Tue</div>
                <div>Wed</div>
                <div>Thu</div>
                <div>Fri</div>
                <div>Sat</div>
            </div>

            <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-2 calendar-wrap">

                {% for week in calendar %}
                {% for day in week %}
                {% if day == 0 %}
                <div></div>
                {% else %}

                {% set full_date = year ~ "-" ~ "%02d"|format(month) ~ "-" ~ "%02d"|format(day) %}

                <div
                    class="bg-white border border-gray-200 rounded-lg p-2 min-h-[110px] shadow-sm hover:shadow-md transition relative">


                    <div class="text-sm font-bold
                        {% if full_date == today %}
                            text-purple-700
                        {% else %}
                            text-gray-700
                        {% endif %}
                    ">
                        {{ day }}
                    </div>


                    {% if full_date in events %}
                    <div class="mt-1 space-y-2 max-h-20 overflow-y-auto pr-1">

                        {% for appt in events[full_date] %}

                        <!-- EVENT CARD -->
                        <div class="relative flex flex-col gap-2 p-2 rounded-lg border shadow-sm transition
        {% if appt.Source == 'personal' %}
            bg-purple-50 border-purple-300
            dark:bg-purple-400/30 dark:border-purple-600
        {% else %}
            bg-blue-50 border-blue-300
            dark:bg-blue-400/30 dark:border-blue-600
        {% endif %}
    ">


                            {% if appt.Source == 'personal' %}
                            <form method="POST" action="/delete-event/{{ appt.ID }}">
                                <button type="submit" onclick="return confirm('Delete this event?')" class="absolute top-1 right-1 w-5 h-5 flex items-center justify-center
                       rounded-full bg-purple-500 text-white text-xs
                       hover:bg-purple-600 transition">
                                    ✕
                                </button>
                            </form>
                            {% endif %}

                            <div class="text-sm font-semibold
            {% if appt.Source == 'personal' %}
                text-purple-800 dark:text-purple-700
            {% else %}
                text-blue-800 dark:text-blue-700
            {% endif %}
        ">
                                {{ appt.Type }}
                            </div>

                            <div class="text-[10px] font-medium opacity-70">
                                {% if appt.Source == 'personal' %}
                                🟣 Personal Event
                                {% else %}
                                🔵 Appointment
                                {% endif %}
                            </div>

                            <a target="_blank" href="https://www.google.com/calendar/render?action=TEMPLATE
           &text={{ appt.Type | urlencode }}
           &dates={{ appt.Date.strftime('%Y%m%dT%H%M%S') }}/{{ (appt.Date + timedelta(minutes=30)).strftime('%Y%m%dT%H%M%S') }}
           &details=BookWell Event
           &location=BookWell" class="inline-flex items-center justify-center gap-1 mt-1 px-2 py-1 text-[10px] rounded-md text-white transition
           {% if appt.Source == 'personal' %}
               bg-purple-600 hover:bg-purple-700
           {% else %}
               bg-blue-600 hover:bg-blue-700
           {% endif %}
        ">
                                📅 Add
                            </a>

                        </div>

                        {% endfor %}

                    </div>
                    {% endif %}

                </div>

                {% endif %}
                {% endfor %}
                {% endfor %}

            </div>
        </div>

        <div class="max-w-5xl mx-auto mt-12 space-y-10">

            <div class="bg-white dark:bg-gray-600 dark:text-white p-6 rounded-lg shadow-md">
                <h2 class="text-xl font-bold mb-4  dark:text-white ">+ Add Personal Event</h2>

                <form method="POST" action="/add-event" class="space-y-4">

                    <input type="text" name="title" placeholder="Event name" class="w-full border px-4 py-2 rounded-lg"
                        required>

                    <input type="date" name="date" class="w-full border px-4 py-2 rounded-lg " required>

                    <input type="time" name="time" class="w-full border px-4 py-2 rounded-lg" required>

                    <button type="submit" class="w-full bg-purple-700 text-white py-2 rounded-lg hover:bg-purple-800">
                        Add Event
                    </button>

                </form>
            </div>

            <div class="bg-white dark:bg-gray-600 dark:text-white p-6 rounded-lg shadow-md">

                <h2 class="text-xl font-bold mb-4 text-gray-800 dark:text-white">
                    Find Available Doctors
                </h2>

                <form method="POST" action="/suggdoctors" class="space-y-4">


                    <input type="date" name="date" required class="w-full px-4 py-2 rounded-lg border
        bg-white text-gray-800 border-gray-300
        focus:outline-none focus:ring-2 focus:ring-green-500
        dark:bg-gray-700 dark:text-white dark:border-gray-600">

                    <select name="category" class="w-full px-4 py-2 rounded-lg border
        bg-white text-gray-800 border-gray-300
        focus:outline-none focus:ring-2 focus:ring-green-500
        dark:bg-gray-700 dark:text-white dark:border-gray-600">

                        <option value="">All Categories</option>
                        <option value="Cardiology">Cardiology</option>
                        <option value="Neurology">Neurology</option>
                        <option value="Orthopedics">Orthopedics</option>

                    </select>


                    <input type="text" name="insurance" placeholder="Enter insurance (e.g. Aetna, Blue Cross)" class="w-full px-4 py-2 rounded-lg border
        bg-white text-gray-800 border-gray-300
        focus:outline-none focus:ring-2 focus:ring-green-500
        dark:bg-gray-700 dark:text-white dark:border-gray-600">

                    <button type="submit" class="w-full bg-green-600 text-white py-2 rounded-lg 
        hover:bg-green-700 transition duration-200 shadow-sm">
                        Suggest Doctors
                    </button>

                </form>

            </div>

        </div>

    </section>

    <footer class="bg-[#57068c] text-white text-center py-4 mt-auto">
        © 2026 — Book fast. Smart care, no cast
    </footer>
    <script>
        const toggle = document.getElementById("theme-toggle");

        if (localStorage.getItem("theme") === "dark") {
            document.documentElement.classList.add("dark");
        }

        toggle.textContent = document.documentElement.classList.contains("dark") ? "☀️" : "🌙";

        toggle.addEventListener("click", () => {
            document.documentElement.classList.toggle("dark");

            if (document.documentElement.classList.contains("dark")) {
                localStorage.setItem("theme", "dark");
                toggle.textContent = "☀️";
            } else {
                localStorage.setItem("theme", "light");
                toggle.textContent = "🌙";
            }
        });
    </script>

</body>

</html>