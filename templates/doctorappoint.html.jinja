<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Doctor Appointments</title>
  <link rel="shortcut icon" href="/static/images/logotab.png" type="image/x-icon">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  {% include "components/navbartwo.html.jinja" %}

  <section class="flex-1 px-4 md:px-12 py-8 md:py-12 dark:bg-gray-900 dark:text-white">
    <h1 class="text-3xl font-bold mb-6 dark:bg-gray-900 dark:text-white">Manage Appointments</h1>

    {% if appointments %}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for appt in appointments %}
        <div class="bg-white dark:bg-gray-600 dark:text-white rounded-lg shadow-md p-5 border-l-4 border-purple-600 flex flex-col justify-between">
          <div>
            <h3 class="text-lg font-semibold text-gray-800 dark:bg-gray-600 dark:text-white">{{ appt.PatientName }}</h3>
            <p class="text-gray-600 text-sm mt-1 dark:bg-gray-600 dark:text-white">Date: {{ appt.Date.strftime('%Y-%m-%d %H:%M') }}</p>
            <p class="text-gray-600 text-sm dark:bg-gray-600 dark:text-white">Type: {{ appt.Type }}</p>
            <p class="mt-1 text-sm font-medium 
              {% if appt.Status == 'Scheduled' %}text-yellow-600
              {% elif appt.Status == 'Confirmed' %}text-green-600
              {% elif appt.Status == 'Cancelled' %}text-red-600
              {% endif %}">
              Status: {{ appt.Status }}
            </p>
          </div>

          <div class="mt-4 flex flex-col gap-2">

            {% if appt.Status != 'Cancelled' %}
            <form method="POST" class="flex gap-2">
              <input type="hidden" name="appointment_id" value="{{ appt.ID }}">
              <input type="hidden" name="action" value="cancel">
              <button class="px-3 py-1 bg-red-500 text-white rounded hover:bg-red-600 transition">
                Cancel
              </button>
            </form>
            {% endif %}


            <form method="POST" class="flex flex-col gap-1">
              <input type="hidden" name="appointment_id" value="{{ appt.ID }}">
              <input type="hidden" name="action" value="reschedule">
              <div class="flex gap-2">
                <input type="date" name="new_date" class="border px-2 py-1 rounded flex-1" required>
                <input type="time" name="new_time" class="border px-2 py-1 rounded flex-1" required>
              </div>
              <button class="mt-1 px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600 transition">
                Reschedule
              </button>
            </form>
          </div>
        </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="text-gray-600 mt-4">No appointments scheduled.</p>
    {% endif %}
  </section>

  <section class="px-4 md:px-12 py-8 md:py-12 dark:bg-gray-900 dark:text-white">
  
  <h2 class="text-2xl font-bold mb-6">Patient Reviews</h2>

  {% if reviews %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      {% for review in reviews %}
      <div class="bg-white dark:bg-gray-600 rounded-lg shadow-md p-5 border-l-4 border-purple-600">

        <h3 class="font-semibold text-lg">{{ review.PatientName }}</h3>

        <p class="text-gray-600 text-sm mt-1 dark:text-white">
          {{ review.Comments }}
        </p>

        <p class="text-sm mt-2 font-medium">
          Rating: {{ review.Rating }}/5
        </p>

        {% if review.Reply %}
        <div class="mt-3 p-2 bg-purple-100 dark:bg-purple-900 rounded">
          <p class="text-xs font-semibold">Your Reply:</p>
          <p class="text-sm">{{ review.Reply }}</p>
        </div>
        {% endif %}

        <form method="POST" action="/doctor/{{ doctor.ID }}/reply_review" class="mt-3">
          <input type="hidden" name="review_id" value="{{ review.ID }}">

          <textarea name="reply"
            placeholder="Write a reply..."
            class="w-full border px-2 py-1 rounded text-sm 
                   bg-white text-black 
                   dark:bg-gray-800 dark:text-white">
          </textarea>

          <button class="mt-2 px-3 py-1 bg-purple-600 text-white rounded hover:bg-purple-700">
            Reply
          </button>
        </form>

      </div>
      {% endfor %}

    </div>
  {% else %}
    <p class="text-gray-500">No reviews yet.</p>
  {% endif %}

</section>

  <footer class="bg-[#57068c] text-white text-center py-4 mt-auto">
    © 2026 — Book fast. Smart care, no cast
  </footer>

</body>
</html>