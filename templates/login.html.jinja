<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen flex flex-col bg-gray-50">
{% include "components/navbar.html.jinja"%}

  <section class="min-h-[40vh] radial-gradient(at 0% 50%, rgb(254, 202, 202), rgb(220, 38, 38)) flex items-center justify-center px-6">
    <div class="max-w-3xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white drop-shadow">
        Welcome Back
      </h1>
      <p class="mt-4 text-lg md:text-xl text-white/90">
        Sign in to manage your appointments and stay in control.
      </p>
    </div>
  </section>

  <section class="flex-1 flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-md bg-white rounded-xl shadow-lg p-8">

      <h2 class="text-2xl font-bold text-gray-900 text-center">
        Login to Your Account
      </h2>

      <form action="/login" method="post" class="mt-8 space-y-6">

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Email Address
          </label>
          <input
            type="email"
            placeholder="you@example.com"
            class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-red-500 focus:outline-none"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Password
          </label>
          <input
            type="password"
            placeholder="••••••••"
            class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-red-500 focus:outline-none"
          />
        </div>


        <div class="flex items-center justify-between text-sm">
          <label class="flex items-center gap-2 text-gray-600">
            <input type="checkbox" class="rounded border-gray-300">
            Remember me
          </label>
        </div>

        <button
          type="submit"
          class="w-full px-6 py-3 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition"
        >
          Sign In
        </button>

      </form>

      <div class="my-6 flex items-center">
        <div class="flex-1 border-t"></div>
        <span class="px-3 text-sm text-gray-400">or</span>
        <div class="flex-1 border-t"></div>
      </div>


      <button class="w-full px-6 py-3 border border-red-600 text-red-600 font-semibold rounded-lg hover:bg-red-50 transition">
        Connect with MyChart
      </button>

      <p class="mt-6 text-center text-sm text-gray-600">
        Don’t have an account?
        <a href="/signup" class="text-red-600 font-semibold hover:underline">
          Sign up
        </a>
      </p>

    </div>
  </section>

</body>
</html>
