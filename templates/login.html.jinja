<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen flex flex-col bg-purple-50">
  {% include "components/navbar.html.jinja"%}

  <section class="min-h-[40vh] bg-gradient-to-r from-[#57068c] to-purple-700 flex items-center justify-center px-6">
    <div class="max-w-3xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-white drop-shadow">
        Welcome Back
      </h1>
      <p class="mt-4 text-lg md:text-xl text-white/90">
        Sign in to manage your appointments and stay in control.
      </p>
    </div>
  </section>

  <section class="flex-1 flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-md bg-white rounded-xl shadow-lg p-8">

      <h2 class="text-2xl font-bold text-[#57068c] text-center">
        Login to Your Account
      </h2>

      <form action="/login" method="post" class="mt-8 space-y-6">

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Email Address
          </label>
          <input   name="email" type="email" placeholder="you@example.com"
            class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#57068c] focus:outline-none" />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Password
          </label>
          <input  name="password" type="password" placeholder="••••••••"
            class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-[#57068c] focus:outline-none" />
        </div>

        <div class="flex items-center justify-between text-sm">
          <label class="flex items-center gap-2 text-gray-600">
            <input type="checkbox" class="rounded border-gray-300 text-[#57068c] focus:ring-[#57068c]">
            Remember me
          </label>
        </div>

        <button type="submit"
          class="w-full px-6 py-3 bg-[#57068c] text-white font-semibold rounded-lg hover:bg-purple-800 transition">
          Sign In
        </button>

      </form>

      <div class="my-6 flex items-center">
        <div class="flex-1 border-t"></div>
        <span class="px-3 text-sm text-gray-400">or</span>
        <div class="flex-1 border-t"></div>
      </div>

      <a href="https://mychart.nyulmc.org/mychart/Authentication/Login" target="_blank" rel="noopener noreferrer"
        class="w-full block text-center px-6 py-3 border border-[#57068c] text-[#57068c] font-semibold rounded-lg hover:bg-purple-100 transition">
        Connect with MyChart
      </a>


      <p class="mt-6 text-center text-sm text-gray-600">
        Don’t have an account?
        <a href="/signup" class="text-[#57068c] font-semibold hover:underline">
          Sign up
        </a>
      </p>

    </div>
  </section>

</body>

</html>