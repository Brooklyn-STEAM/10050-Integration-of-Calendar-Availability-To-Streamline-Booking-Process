<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact Us | BookWell</title>
  <link rel="shortcut icon" href="/static/images/logotab.png" type="image/x-icon">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-white text-gray-900 dark:bg-gray-600 dark:text-white min-h-screen flex flex-col">

  {% include "components/navbar.html.jinja" %}

  <main class="flex-grow">

    <section class="px-4 sm:px-6 py-12 sm:py-16 bg-gray-50 dark:bg-gray-900 dark:text-white">
      <div class="max-w-4xl mx-auto text-center dark:text-white">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 sm:mb-6 dark:text-white">
          We're here to help.
        </h1>
        <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto dark:text-white">
          Whether you have a question about your booking, need support,
          or just want to say hello — the BookWell team is ready.
        </p>
      </div>
    </section>

    <section class="px-4 sm:px-6 py-12 sm:py-16 dark:bg-gray-900 dark:text-white ">
      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-start ">

        <div class="bg-gray-50 rounded-2xl p-6 sm:p-8 shadow-sm h-fit dark:bg-gray-600 dark:text-white">
          <div class="mb-6">
            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-100 rounded-lg flex items-center justify-center">
              <svg class="w-5 h-5 sm:w-6 sm:h-6 text-indigo-600" fill="none" stroke="currentColor" stroke-width="2"
                viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
          </div>

          <h3 class="text-lg sm:text-xl font-semibold mb-4">Email Support</h3>
          <p class="text-gray-600 mb-6 text-sm sm:text-base  dark:text-white">
            Reach out to any of our team members directly.
          </p>

          <div class="space-y-3 break-words text-sm sm:text-base">
            <a href="mailto:jquiles@brooklynsteamcenter.org"
              class="block text-indigo-600 font-medium hover:underline dark:text-white">
              jquiles@brooklynsteamcenter.org
            </a>

            <a href="mailto:swhite2@brooklynsteamcenter.org"
              class="block text-indigo-600 font-medium hover:underline dark:text-white">
              swhite2@brooklynsteamcenter.org
            </a>

            <a href="mailto:jprity@brooklynsteamcenter.org"
              class="block text-indigo-600 font-medium hover:underline dark:text-white">
              jprity@brooklynsteamcenter.org
            </a>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-600 dark:text-white rounded-2xl shadow-lg p-6 sm:p-8 md:p-10 border border-gray-100">
          <h2 class="text-xl sm:text-2xl font-bold mb-6">
            Send us a message
          </h2>

          <form method="POST" action="{{ url_for('contact') }}" class="space-y-5 sm:space-y-6 ">

            <div>
              <label class="block text-sm font-medium mb-2">Full Name</label>
              <input type="text" name="name" required
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div>
              <label class="block text-sm font-medium mb-2">Email Address</label>
              <input type="email" name="email" required
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div>
              <label class="block text-sm font-medium mb-2">How can we help?</label>
              <textarea rows="5" name="message" required
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-sm sm:text-base focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
            </div>

            <button type="submit"
              class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-lg transition text-sm sm:text-base">
              Send Message
            </button>

          </form>
        </div>

      </div>
    </section>

  </main>

  <footer class="px-4 sm:px-6 py-6 sm:py-8 text-center text-gray-500 text-xs sm:text-sm border-t dark:text-white">
    © 2026 BookWell. All rights reserved.
  </footer>
  <script>
  const toggle = document.getElementById("theme-toggle");

  // Load saved theme
  if (localStorage.getItem("theme") === "dark") {
    document.documentElement.classList.add("dark");
  }

  // Set icon on load
  toggle.textContent = document.documentElement.classList.contains("dark") ? "☀️" : "🌙";

  toggle.addEventListener("click", () => {
    document.documentElement.classList.toggle("dark");

    if (document.documentElement.classList.contains("dark")) {
      localStorage.setItem("theme", "dark");
      toggle.textContent = "☀️";
    } else {
      localStorage.setItem("theme", "light");
      toggle.textContent = "🌙";
    }
  });
</script>

</body>
</html>