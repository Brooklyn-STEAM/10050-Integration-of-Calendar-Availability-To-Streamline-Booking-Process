<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="/static/images/logotab.png" type="image/x-icon">

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <title>Patient Profile | Bookwell</title>
</head>


<body class="bg-gray-50 min-h-screen flex flex-col dark:bg-gray-900">

    {% include "components/navbar.html.jinja" %}

    <section class="flex-1 px-4 md:px-12 py-8 md:py-12 dark:text-white">


        <h1 class="text-3xl font-bold mb-6">
            {{patient.Name}}'s Profile
        </h1>
        

        {%if appointments%}

        <div class="grid grid-cols-1 md:grid-cols-2 lg: grid-cols-3 gap-6">

            {% for appt in appointments%}
            <div class="bg-white dark:bg-gray-600 rounded-lg shadow-md p-5 border-l-4
    border-purple-600 flex flex-col justify-between">

                <div>
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white">
                        Doctor:{{appt.DoctorName}}
                    </h3>

                    <p class="text-gray-600 text-sm mt-1 dark:text-gray-200">
                        Date: {{ appt["Date"].strftime("%B %d, %Y") }}
                        at {{ appt["Date"].strftime("%H:%M") }}
                    </p>

                    <p class="text-gray-600 text-sm dark:text-gray-200">
                        Type: {{ appt.Type}}
                    </p>

                    <p class="mt-2 text-sm font-medium
             {% if appt.Status == 'Scheduled' %}text-yellow-600
             {% elif appt.Status == 'Confirmed' %}text-green-600
             {% elif appt.Status == 'Cancelled' %}text-red-600
             {% endif %}">
                        Status: {{ appt.Status }}
                    </p>
                </div>



            </div>

            {%endfor%}

        </div>

        {%else%}

        <p class="text-gray-600 dark:text-gray-300">
            No current appointments right now
        </p>

        {% endif %}
    </section>



    <footer class="bg-[#57068c] text-white text-center py-4 mt-auto">
        © 2026 — Book fast. Smart care, no cast
    </footer>

</body>

</html>


</body>