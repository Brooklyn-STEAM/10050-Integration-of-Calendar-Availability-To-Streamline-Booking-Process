<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Forgot Password</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    body {
      background:
        radial-gradient(circle at top left, rgba(168,85,247,0.18), transparent 30%),
        radial-gradient(circle at bottom right, rgba(147,51,234,0.12), transparent 25%),
        #0f0f0f;
    }

    .glass {
      background: rgba(20,20,20,0.72);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .purple-text {
      color: #a855f7;
    }

    .purple-border {
      border-color: rgba(168,85,247,0.45);
    }

    .purple-glow:hover {
      box-shadow: 0 0 30px rgba(168,85,247,0.4);
      transform: translateY(-2px);
    }

    .luxury-pattern {
      background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
      background-size: 40px 40px;
    }
  </style>
</head>

<body class="min-h-screen flex items-center justify-center px-6 luxury-pattern">

  <div class="w-full max-w-5xl grid lg:grid-cols-2 rounded-3xl overflow-hidden shadow-2xl glass">

    <!-- LEFT SIDE -->
    <div class="hidden lg:flex flex-col justify-center px-14 py-16 relative overflow-hidden">

      <div class="absolute inset-0 opacity-10">
        <img
          src="/static/images/doctorlog.jpeg"
          class="w-full h-full object-cover"
        >
      </div>

      <div class="relative z-10 space-y-6">

        <div class="space-y-2">
          <p class="uppercase tracking-[0.4em] text-sm purple-text">
            BookWell
          </p>

          <h1 class="text-5xl font-semibold text-white leading-tight">
            Recover <br> Your Account
          </h1>
        </div>

        <p class="text-gray-300 text-lg leading-relaxed max-w-md">
          Reset your password securely and regain access to your healthcare dashboard.
        </p>

        <div class="pt-8">
          <div class="w-20 h-[2px] bg-purple-500"></div>
        </div>

      </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="bg-[#111111] px-8 py-14 lg:px-14 flex items-center">

      <div class="w-full space-y-8">

        <div class="space-y-3">

          <h2 class="text-4xl font-semibold text-white">
            Forgot Password
          </h2>

          <p class="text-gray-400 leading-relaxed">
            Enter your email and we’ll send you a secure password reset link.
          </p>

        </div>

        <!-- FORM -->
        <form method="POST" class="space-y-6">

          <div class="space-y-2">

            <label class="text-sm uppercase tracking-widest text-gray-400">
              Email Address
            </label>

            <input
              type="email"
              name="email"
              required
              placeholder="you@example.com"
              class="w-full bg-[#1a1a1a]
                     border purple-border
                     text-white
                     px-5 py-4 rounded-2xl
                     focus:outline-none
                     focus:ring-2
                     focus:ring-purple-600
                     placeholder:text-gray-500"
            >

          </div>

          <!-- BUTTON -->
          <button
            type="submit"
            class="w-full bg-purple-600 hover:bg-purple-700
                   text-white py-4 rounded-2xl
                   transition duration-300
                   font-medium tracking-wide purple-glow">

            Send Reset Link

          </button>

        </form>

        <!-- BACK -->
        <div class="pt-2">

          <a
            href="/login"
            class="text-gray-400 hover:text-purple-400 transition text-sm tracking-wide">

            ← Back to Login

          </a>

        </div>

      </div>

    </div>

  </div>

</body>
</html>