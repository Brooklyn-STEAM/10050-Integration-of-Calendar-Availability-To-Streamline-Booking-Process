<!doctype html>
<html>

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="/static/images/logotab.png">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-purple-50 min-h-screen dark:bg-gray-900 dark:text-white">

    {% include "components/navbar.html.jinja" %}
    {% include "components/chat_widget.html.jinja" %}
    {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
    <div class="max-w-5xl mx-auto mt-6 px-4">
        {% for category, message in messages %}
        <div class="mb-4 p-4 rounded-lg border shadow-sm
        {% if category == 'error' %} bg-red-50 text-red-700 border-red-200
        {% elif category == 'success' %} bg-green-50 text-green-700 border-green-200
        {% else %} bg-purple-50 text-purple-800 border-purple-200 {% endif %}
        dark:bg-gray-800 dark:border-gray-700 dark:text-white">
            {{ message }}
        </div>
        {% endfor %}
    </div>
    {% endif %}
    {% endwith %}

    <div class="max-w-7xl mx-auto p-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

            <div class="lg:col-span-4">
                <img src="{{ doctor['Image'] }}" class="w-full rounded-xl shadow object-cover">
            </div>

            <div class="lg:col-span-5 space-y-4">

                <h1 class="text-3xl font-bold text-purple-800 dark:text-purple-300">
                    Dr. {{ doctor['Name'] }}
                </h1>

                <p class="text-lg text-gray-700 dark:text-gray-300">
                    {{ doctor['Category'] }} • {{ doctor['Type'] }}
                </p>

                <p class="text-sm text-gray-500 dark:text-gray-400">
                    📍 {{ doctor['Location'] }}
                </p>

                {% if average_rating %}
                <div class="flex items-center gap-2">
                    <div class="flex">
                        {% for i in range(1, 6) %}
                        {% if average_rating >= i %}
                        <span class="text-white-400">★</span>
                        {% elif average_rating >= i - 0.5 %}
                        <span class="text-white-300">★</span>
                        {% else %}
                        <span class="text-gray-300 dark:text-gray-600">★</span>
                        {% endif %}
                        {% endfor %}
                    </div>
                    <p class="text-sm text-gray-600 dark:text-gray-300">
                        {{ average_rating }}/5 ({{ reviews|length }} reviews)
                    </p>
                </div>
                {% else %}
                <p class="text-gray-400">No reviews yet</p>
                {% endif %}

                <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow">
                    <h2 class="font-semibold mb-2">About</h2>
                    <p class="text-sm text-gray-600 dark:text-gray-300">
                        {{ doctor['Description'] }}
                    </p>
                </div>

                <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow">
                    <h2 class="font-semibold mb-2">Insurance</h2>
                    <p class="text-sm text-gray-600 dark:text-gray-300">
                        {{ doctor['Insurance'] }}
                    </p>
                </div>

            </div>

            <div class="lg:col-span-3">
                <div class="bg-white p-6 rounded shadow space-y-4 dark:bg-gray-600 dark:text-white">

                    <h2 class="text-xl font-semibold text-purple-800 dark:text-white">
                        Book an Appointment
                    </h2>

                    <p class="text-purple-800 font-semibold dark:text-white">
                        Accepting New Patients
                    </p>

                    <form method="get" class="space-y-3">
                        <div>
                            <label class="block mb-1 text-sm">Select Date</label>
                            <input type="date" name="date" value="{{ selected_date }}" required
                                class="w-full px-3 py-2 border rounded" />
                        </div>

                        <div>
                            <label class="block mb-1 text-sm">Visit Type</label>
                            <select name="visit_type" class="w-full px-3 py-2 border rounded">
                                <option value="In-Person">In-Person</option>
                                <option value="Virtual">Virtual</option>
                            </select>
                        </div>

                        <button type="submit" class="px-4 py-2 bg-purple-700 text-white rounded">
                            Check Availability
                        </button>
                    </form>

                    {% if available_slots %}
                    <div class="mt-4">
                        <h3 class="font-semibold">Available Times:</h3>

                        <div class="flex flex-wrap gap-2 mt-2">
                            {% for slot in available_slots %}
                            <form method="post" action="/doctor/{{ doctor['ID'] }}/book">

                                <input type="hidden" name="date" value="{{ selected_date }}">
                                <input type="hidden" name="time" value="{{ slot.strftime('%H:%M') }}">
                                <input type="hidden" name="visit_type" value="{{ visit_type }}">

                                <button type="submit"
                                    class="px-3 py-1 bg-purple-600 text-white rounded hover:bg-purple-700">
                                    {{ slot.strftime("%H:%M") }}
                                </button>

                            </form>
                            {% endfor %}
                        </div>
                    </div>

                    {% else %}
                    <p class="text-sm text-gray-500">
                        Select a date to see available times.
                    </p>
                    {% endif %}
                </div>
            </div>



            </form>

        </div>
    </div>

    </div>
    </div>


    <div class="max-w-4xl mx-auto p-6 mt-12">

        <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow">

            <h2 class="text-xl font-bold mb-6 text-center">Patient Reviews</h2>


            <form method="post" action="/doctor/{{doctor['ID']}}/review" class="space-y-4 mb-10">

                <select name="rating" class="w-full px-3 py-2 border rounded dark:bg-gray-700">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                </select>

                <input type="text" name="name" placeholder="Your name"
                    class="w-full px-3 py-2 border rounded dark:bg-gray-700">

                <textarea name="comments" rows="3" placeholder="Write your review..."
                    class="w-full px-3 py-2 border rounded dark:bg-gray-700"></textarea>

                <button class="w-full bg-purple-700 text-white py-2 rounded">
                    Submit Review
                </button>
            </form>


            {% for review in reviews %}
            <div class="border-b border-gray-200 dark:border-gray-700 py-4">

                <p class="font-semibold">
                    {{ review["Name"][0] + ('*' * (review["Name"]|length - 1)) }}
                </p>

                <p class="text-sm text-gray-600 dark:text-gray-300">
                    {{ review["Comments"] }}
                </p>


                <div class="flex mt-1">
                    {% for i in range(1, 6) %}
                    {% if review["Rating"] >= i %}
                    <span class="text-p-400">★</span>
                    {% else %}
                    <span class="text-gray-300 dark:text-gray-600">★</span>
                    {% endif %}
                    {% endfor %}
                </div>


                <form method="POST" action="/doctor/{{review['DoctorID']}}/remove_review">
                    <input type="hidden" name="review_id" value="{{ review['ID'] }}">
                    <button class="text-sm text-red-500 mt-2">Delete</button>
                </form>


                {% if review["Reply"] %}
                <div class="mt-2 p-2 bg-purple-100 dark:bg-gray-700 rounded">
                    <p class="text-xs font-semibold">Doctor Response:</p>
                    <p class="text-xs">{{ review["Reply"] }}</p>
                </div>
                {% endif %}

            </div>
            {% endfor %}

        </div>
    </div>

</body>

</html>
<script>
 function toggleChat() {
  document.getElementById("chat-widget").classList.toggle("hidden");
}</script>