<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="shortcut icon" href="/static/images/logotab.png" type="image/x-icon">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>My Appointments</title>
</head>

<body class="bg-purple-50 text-gray-800 dark:bg-gray-900 dark:text-white">

  {% include "components/navbar.html.jinja" %}

  <main class="max-w-6xl mx-auto px-6 py-12">

    <h1 class="text-3xl font-semibold mb-8 border-b border-purple-200 pb-4 text-[#57068c] dark:text-white ">
      My Appointments
    </h1>

    {% if appointments|length == 0 %}
    <div class="text-center py-20 bg-white rounded-xl shadow-md">
      <p class="text-lg mb-6 text-gray-600">
        You don’t have any appointments scheduled yet.
      </p>

      <a href="/doctorsearch"
        class="inline-block bg-[#57068c] hover:bg-purple-800 text-white px-6 py-3 rounded-lg transition">
        Book an Appointment
      </a>
    </div>

    {% else %}
    {% for appointment in appointments %}
    <div class="bg-white dark:bg-gray-500 dark:text-white rounded-xl shadow-md mb-8 p-6 hover:shadow-lg transition">

      <div
        class="flex flex-col md:flex-row md:justify-between md:items-center border-b border-purple-200 pb-4 mb-4 gap-4">
        <div>
          <p class="font-semibold text-lg text-[#57068c] dark:text-white">
            Appointment #{{ loop.index }}
          </p>
          <p class="text-sm text-gray-500 dark:text-white">
            Dr. {{ appointment["DoctorName"] }}
          </p>
        </div>

        <span class="px-4 py-1 rounded-full text-sm font-medium 
          {% if appointment['Status'] == 'Confirmed' %}
            bg-green-100 text-green-700
          {% elif appointment['Status'] == 'Pending' %}
            bg-yellow-100 text-yellow-700
          {% elif appointment['Status'] == 'Cancelled' %}
            bg-gray-100 text-gray-700
          {% else %}
            bg-red-100 text-red-700
          {% endif %}">
          {{ appointment["Status"] }}
        </span>
      </div>

      <div class="flex flex-col md:flex-row md:justify-center gap-6">

        <div>
          <p class="font-medium">Date & Time</p>
          <p class="text-sm text-gray-600 dark:text-white">
            {{ appointment["Date"].strftime("%B %d, %Y") }} at {{ appointment["Date"].strftime("%H:%M") }}
          </p>
        </div>

        <div>
          <p class="font-medium">Location</p>
          <p class="text-sm text-gray-600 dark:text-white">
            {{ appointment["Location"] }}
          </p>
        </div>

        <div class="flex gap-3 mt-2 md:mt-0">

          {% if appointment["Status"] == "Scheduled" %}
          <form action="/appoint/{{ appointment['ID'] }}/cancel" method="POST">
            <button type="submit" class="bg-purple-900 hover:bg-purple-700 text-white px-4 py-2 rounded-lg transition">
              Cancel
            </button>
          </form>
          {% endif %}

          {% if appointment["Status"] == "Scheduled" %}
          <form action="/appoint/{{ appointment['ID'] }}/attend" method="POST">
            <button type="submit" class="bg-purple-900 hover:bg-purple-700 text-white px-4 py-2 rounded-lg transition">
              Mark as Attended
            </button>
          </form>
          {% endif %}

        </div>

      </div>

    </div>
    {% endfor %}
    {% endif %}


  </main>

<script>
  const toggle = document.getElementById("theme-toggle");

  // Load saved theme
  if (localStorage.getItem("theme") === "dark") {
    document.documentElement.classList.add("dark");
  }

  // Set icon on load
  toggle.textContent = document.documentElement.classList.contains("dark") ? "☀️" : "🌙";

  toggle.addEventListener("click", () => {
    document.documentElement.classList.toggle("dark");

    if (document.documentElement.classList.contains("dark")) {
      localStorage.setItem("theme", "dark");
      toggle.textContent = "☀️";
    } else {
      localStorage.setItem("theme", "light");
      toggle.textContent = "🌙";
    }
  });
</script>

</body>

</html>