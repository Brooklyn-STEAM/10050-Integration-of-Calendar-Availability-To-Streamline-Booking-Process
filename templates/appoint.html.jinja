<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <title>My Appointments</title>
</head>

<body class="bg-purple-50 text-gray-800">

  {% include "components/navbar.html.jinja" %}

  <main class="max-w-6xl mx-auto px-6 py-12">

    <h1 class="text-3xl font-semibold mb-8 border-b border-purple-200 pb-4 text-[#57068c]">
      My Appointments
    </h1>

    {% if appointments|length == 0 %}
      <div class="text-center py-20 bg-white rounded-xl shadow-md">
        <p class="text-lg mb-6 text-gray-600">
          You don’t have any appointments scheduled yet.
        </p>

        <a href="/doctorsearch"
           class="bg-[#57068c] text-white px-6 py-3 rounded-lg hover:bg-purple-800">
          Book an Appointment
        </a>
      </div>

    {% else %}
      {% for appointment in appointments %}

      <div class="bg-white rounded-xl shadow-md mb-8 p-6">

        <div class="flex justify-between items-center border-b pb-4 mb-4">
          <div>
            <p class="font-semibold text-lg text-[#57068c]">
              Appointment #{{ loop.index }}
            </p>
            <p class="text-sm text-gray-500">
              Dr. {{ appointment["DoctorName"] }}
            </p>
          </div>

          <span class="px-3 py-1 rounded-full text-sm
            {% if appointment['Status'] == 'Confirmed' %}
              bg-green-100 text-green-700
            {% elif appointment['Status'] == 'Scheduled' %}
              bg-blue-100 text-blue-700
            {% elif appointment['Status'] == 'Cancelled' %}
              bg-gray-100 text-gray-700
            {% else %}
              bg-yellow-100 text-yellow-700
            {% endif %}
          ">
            {{ appointment["Status"] }}
          </span>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-4">
          <div>
            <p class="font-medium">Date & Time</p>
            <p class="text-sm text-gray-600">
              {{ appointment["Date"].strftime("%B %d, %Y") }}  
              at {{ appointment["Date"].strftime("%H:%M") }}
            </p>
          </div>

          <div>
            <p class="font-medium">Location</p>
            <p class="text-sm text-gray-600">
              {{ appointment["Location"] }}
            </p>
          </div>
        </div>

        <div class="flex gap-3 flex-wrap">

          {% if appointment["Status"] == "Scheduled" %}
            <form action="/appoint/{{ appointment['ID'] }}/cancel" method="POST">
              <button class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">
                Cancel
              </button>
            </form>
          {% endif %}

          {% if appointment["Status"] == "Scheduled" %}
            <form action="/appoint/{{ appointment['ID'] }}/attend" method="POST">
              <button class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">
                Mark as Attended
              </button>
            </form>
          {% endif %}

          {% if appointment["Status"] in ["Scheduled", "Confirmed"] %}

            <a href="/doctor/{{ appointment['DoctorID'] }}"
               class="bg-purple-900 text-white px-4 py-2 rounded-lg hover:bg-purple-700">
              Reschedule
            </a>
          {% endif %}

        </div>

      </div>

      {% endfor %}
    {% endif %}

  </main>
</body>
</html>